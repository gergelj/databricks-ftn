{
  "datasets": [
    {
      "name": "ds_deliveries",
      "displayName": "Deliveries",
      "queryLines": [
        "SELECT order_id, order_date, order_ts, hour(order_ts) AS order_hour, delivery_district, restaurant_name, cuisine, CASE WHEN is_late THEN 1 ELSE 0 END AS late_flag, delivery_minutes, delay_minutes, total_amount_rsd, rating FROM gold.deliveries"
      ],
      "catalog": "databricks_ftn_catalog",
      "schema": "gold"
    },
    {
      "name": "ds_late_reviews",
      "displayName": "Late orders with a review",
      "queryLines": [
        "SELECT order_id, order_ts, delivery_district, restaurant_name, delay_minutes, rating, review_text FROM gold.deliveries WHERE is_late AND review_text IS NOT NULL"
      ],
      "catalog": "databricks_ftn_catalog",
      "schema": "gold"
    },
    {
      "name": "ds_live",
      "displayName": "Live delivery time (5-minute windows)",
      "queryLines": [
        "SELECT window_start, delivery_district, deliveries, avg_delivery_minutes, late_deliveries FROM gold.avg_delivery_time_per_district_5min WHERE window_start >= timestampadd(HOUR, -3, (SELECT max(window_start) FROM gold.avg_delivery_time_per_district_5min))"
      ],
      "catalog": "databricks_ftn_catalog",
      "schema": "gold"
    }
  ],
